# Database Connection
# Primary (Supabase) - All writes go here
PRIMARY_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Replica (Local PostgreSQL) - Read cache
REPLICA_DB_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Legacy support (points to primary)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Sync Configuration
SYNC_ENABLED=true
SYNC_INTERVAL_MS=60000

# JWT Secret - Change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server Port
PORT=3000
