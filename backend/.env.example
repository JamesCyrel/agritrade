# Database Connection (Reversed Architecture: Local Primary → Supabase Warehouse)

# Primary (Local PostgreSQL) - All reads/writes go here
PRIMARY_DB_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Warehouse (Supabase) - Sync target for backup/analytics
WAREHOUSE_DB_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Sync Configuration (Local → Supabase)
SYNC_ENABLED=true
SYNC_INTERVAL_MS=60000

# Legacy support (for backwards compatibility)
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5432/postgres

# JWT Secret - Change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server Port
PORT=3000
